# ==============================================================================
# CollegeOS Backend Environment Configuration Example
# Institution: Swami Vivekanand Subharti University / Subharti Polytechnic
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Database Connection (Local instance or MongoDB Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/collegeos
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/collegeos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/collegeos

# JSON Web Token Secret & Expiry
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# SMTP Email Configuration for Password Recovery (Optional in dev; dev fallback logs reset links)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@subharti.org
SMTP_PASS=your_smtp_app_password_here
EMAIL_FROM="CollegeOS Gateway <no-reply@subharti.org>"
